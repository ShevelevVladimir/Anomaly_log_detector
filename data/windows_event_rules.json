        "policy": "detect_cmd_network_activity"
      },
      {
        "id": "rare_process_external_connection",
        "source": "sysmon_or_wfp",
        "destination": "external",
        "threshold": "rare_outbound_connections"
      }
    ]
  },
  "data_exfiltration": {
    "name_ru": "Подозрительный вывод данных",
    "mitre": "T1041",
    "event_ids": [
      4663,
      5140,
      5145
    ],
    "sysmon_ids": [
      3,
      11
    ],
    "fields": [
      "event_id",
      "Accesses",
      "ObjectName",
      "ShareName",
      "RelativeTargetName",
      "TargetFilename",
      "DestinationIp",
      "bytes"
    ],
    "features": [
      "win_file_read_count",
      "win_smb_object_access_count",
      "win_archive_create_count",
      "external_bytes_sum"
    ],
    "rules": [
      {
        "id": "mass_file_read",
        "event_id": [
          4663,
          5145
        ],
        "field": "Accesses",
        "contains": "ReadData",
        "threshold": "mass_file_read_events",
        "policy": "monitor_mass_file_read"
      },
      {
        "id": "archive_in_suspicious_path",
        "sysmon_id": 11,
        "field": "TargetFilename",
        "extensions": "archive_extensions",
        "paths": "suspicious_archive_paths",
        "threshold": 1,
        "policy": "detect_suspicious_archives"
      }
    ]
  },
  "dns_anomaly": {
    "name_ru": "DNS-аномалия",
    "mitre": "T1071.004",
    "event_ids": [],
    "sysmon_ids": [
      22
    ],
    "fields": [
      "event_id",
      "QueryName",
      "Image",
      "User"
    ],
    "features": [
      "dns_query_count",
      "unique_domains",
