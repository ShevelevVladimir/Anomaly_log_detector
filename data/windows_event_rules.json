{
  "bruteforce": {
    "name_ru": "Подбор учетных данных",
    "mitre": "T1110",
    "event_ids": [
      4625,
      4771,
      4776,
      4740
    ],
    "support_event_ids": [
      4624
    ],
    "fields": [
      "event_id",
      "SubStatus",
      "Status",
      "TargetUserName",
      "IpAddress",
      "WorkstationName",
      "LogonType"
    ],
    "features": [
      "win_logon_failed_count",
      "win_unknown_user_count",
      "win_wrong_password_count",
      "win_account_locked_count",
      "win_success_after_failures"
    ],
    "rules": [
      {
        "id": "wrong_password_threshold",
        "event_id": 4625,
        "field": "SubStatus",
        "value": "0xC000006A",
        "threshold": "brute_fails",
        "policy": "ignore_single_wrong_password"
      },
      {
        "id": "unknown_user_threshold",
        "event_id": 4625,
        "field": "SubStatus",
        "value": "0xC0000064",
        "threshold": "unknown_user_fails",
        "policy": "strict_unknown_user_control"
      },
      {
        "id": "kerberos_ntlm_failures",
        "event_id": [
          4771,
          4776
        ],
        "threshold": "brute_fails"
      },
      {
        "id": "account_lockout",
        "event_id": 4740,
        "threshold": 1
      },
      {
        "id": "success_after_failures",
        "event_id_sequence": [
          4625,
          4624
        ],
        "threshold": "successful_login_after_failures",
        "policy": "detect_success_after_failures"
      }
    ]
  },
  "scan": {
    "name_ru": "Сканирование",
    "mitre": "T1046",
    "event_ids": [
      5157
    ],
    "support_event_ids": [
      5152,
      5156
    ],
    "sysmon_ids": [
      3
    ],
    "fields": [
      "event_id",
      "DestinationIp",
      "DestinationPort",
      "SourceAddress",
      "DestAddress",
      "DestPort",
      "Protocol",
      "Image"
    ],
    "features": [
      "win_unique_dst_ports",
      "win_unique_dst_ips",
      "win_wfp_blocked_count",
      "win_sysmon_network_count"
    ],
    "rules": [
      {
        "id": "many_destination_ports",
        "source": "sysmon_or_wfp",
        "field": "DestinationPort",
        "threshold": "scan_ports",
        "policy": "exclude_web_ports_from_scan"
      },
      {
        "id": "many_destination_hosts",
        "source": "sysmon_or_wfp",
        "field": "DestinationIp",
        "threshold": "scan_hosts"
      },
      {
        "id": "wfp_blocked_connections",
        "event_id": 5157,
        "threshold": "wfp_blocked_connections",
        "policy": "analyze_wfp_blocked_connections"
      },
      {
        "id": "wfp_blocked_packets_noisy",
        "event_id": 5152,
        "threshold": "wfp_blocked_packets",
        "policy": "enable_noisy_wfp_packet_mode"
      }
    ]
  },
  "flood": {
    "name_ru": "DDoS/флуд-активность",
    "mitre": "T1499",
    "event_ids": [
      5156,
      5157
    ],
    "sysmon_ids": [
      3
    ],
    "fields": [
      "event_id",
      "DestinationIp",
      "DestinationPort",
      "Protocol",
      "SourceAddress",
      "DestAddress"
    ],
    "features": [
      "win_network_event_count",
      "win_target_event_count",
      "win_protocol_count",
      "win_unique_src_count"
    ],
    "rules": [
      {
        "id": "connection_volume_spike",
        "source": "sysmon_or_wfp",
        "threshold": "flood_connections",
        "policy": "enable_flood_detection"
      },
      {
        "id": "target_service_spike",
        "group_by": [
          "DestinationIp",
          "DestinationPort"
        ],
        "threshold": "flood_target_events",
        "policy": "enable_flood_detection"
      }
    ]
  },
  "web_attack": {
    "name_ru": "Подозрительная активность веб-сервиса",
    "mitre": "T1190",
    "event_ids": [
      4688
    ],
    "sysmon_ids": [
      1,
      3
    ],
    "fields": [
      "event_id",
      "ParentImage",
      "Image",
      "CommandLine",
      "cs-uri-stem",
      "cs-uri-query",
      "sc-status"
    ],
    "features": [
      "web_attack_pattern_count",
      "http_error_rate",
      "win_webshell_process_count",
      "win_web_process_network_count"
    ],
    "rules": [
      {
        "id": "web_attack_uri",
        "source": "iis_w3c",
        "field": [
          "cs-uri-stem",
          "cs-uri-query"
        ],
        "patterns": "web_attack_patterns",
        "policy": "enable_web_uri_analysis"
      },
      {
        "id": "web_server_shell",
        "source": "windows_or_sysmon",
        "parent_process": "web_server_process_names",
        "child_process": "suspicious_process_names",
        "policy": "detect_web_server_shell"
      }
    ]
  },
  "suspicious_outbound": {
    "name_ru": "Подозрительная исходящая активность",
    "mitre": "T1071",
    "event_ids": [
      4688,
      5156
    ],
    "sysmon_ids": [
      1,
      3
    ],
    "fields": [
      "event_id",
      "Image",
      "ParentImage",
      "CommandLine",
      "DestinationIp",
      "DestinationPort",
      "Protocol"
    ],
    "features": [
      "win_suspicious_process_count",
      "win_suspicious_process_network_count",
      "external_connection_count"
    ],
    "rules": [
      {
        "id": "cmd_or_powershell_external_connection",
        "process": "suspicious_process_names",
