      "long_dns_query_count"
    ],
    "rules": [
      {
        "id": "long_query_name",
        "sysmon_id": 22,
        "field": "QueryName",
        "min_length": "dns_query_length",
        "policy": "enable_dns_tunneling_detection"
      },
      {
        "id": "many_unique_domains",
        "sysmon_id": 22,
        "field": "QueryName",
        "threshold": "dns_unique_domains",
        "policy": "enable_dns_tunneling_detection"
      }
    ]
  },
  "malware_beaconing": {
    "name_ru": "Признаки командного канала",
    "mitre": "T1071",
    "event_ids": [
      5156
    ],
    "sysmon_ids": [
      3,
      22
    ],
    "fields": [
      "event_id",
      "UtcTime",
      "Image",
      "DestinationIp",
      "DestinationPort",
      "QueryName"
    ],
    "features": [
      "beacon_connection_count",
      "beacon_interval_std",
      "small_external_connection_count",
      "repeated_destination_count"
    ],
    "rules": [
      {
        "id": "periodic_external_connections",
        "group_by": [
          "Image",
          "DestinationIp",
          "DestinationPort"
        ],
        "threshold": "beacon_min_events",
        "max_jitter_percent": "beacon_interval_jitter_percent",
        "policy": "enable_beaconing_periodicity"
      }
    ]
  },
