  "unknown_anomaly": {
    "name_ru": "Неизвестная аномалия",
    "mitre": "T1082",
    "event_ids": [],
    "fields": [
      "anomaly_score"
    ],
    "features": [
      "anomaly_score"
    ],
    "rules": [
      {
        "id": "high_anomaly_score",
        "field": "anomaly_score",
        "threshold": "anomaly_threshold",
        "policy": "show_unknown_anomalies"
      }
    ]
  },
  "_thresholds": {
    "window_minutes": 5,
    "brute_fails": 10,
    "unknown_user_fails": 5,
    "successful_login_after_failures": 5,
    "network_logon_events": 20,
    "smb_access_events": 15,
    "scan_ports": 18,
    "scan_hosts": 20,
    "wfp_blocked_connections": 20,
    "wfp_blocked_packets": 50,
    "flood_connections": 120,
    "flood_target_events": 120,
    "dns_query_length": 60,
    "dns_unique_domains": 20,
    "beacon_min_events": 8,
    "beacon_interval_jitter_percent": 20,
    "mass_file_read_events": 50,
    "rare_outbound_connections": 5,
    "anomaly_threshold": 0.6
  },
  "_policy_options": {
    "ignore_single_wrong_password": true,
    "strict_unknown_user_control": false,
    "detect_success_after_failures": true,
    "allow_rdp_logons": false,
    "allow_smb_rpc_access": true,
    "detect_remote_service_creation": true,
    "exclude_web_ports_from_scan": true,
    "analyze_wfp_blocked_connections": true,
    "enable_noisy_wfp_packet_mode": false,
    "enable_web_uri_analysis": true,
    "detect_web_server_shell": true,
    "detect_cmd_network_activity": true,
    "monitor_mass_file_read": true,
    "detect_suspicious_archives": true,
    "enable_dns_tunneling_detection": true,
    "ignore_internal_dns_domains": true,
    "enable_beaconing_periodicity": true,
    "exclude_known_cloud_services": true,
    "enable_flood_detection": true,
    "show_unknown_anomalies": true
  },
  "_patterns": {
    "suspicious_process_names": [
      "powershell.exe",
      "cmd.exe",
      "wscript.exe",
      "cscript.exe",
      "rundll32.exe",
      "regsvr32.exe",
      "certutil.exe",
      "bitsadmin.exe",
      "mshta.exe",
      "wmic.exe",
      "psexec.exe",
      "vssadmin.exe",
      "wevtutil.exe",
      "bcdedit.exe",
      "net.exe",
      "net1.exe"
    ],
    "web_server_process_names": [
      "w3wp.exe",
      "tomcat.exe",
      "java.exe",
      "nginx.exe",
      "httpd.exe",
      "apache.exe",
      "php-cgi.exe"
    ],
    "archive_extensions": [
      ".zip",
      ".rar",
      ".7z",
      ".tar",
      ".gz"
    ],
    "suspicious_archive_paths": [
      "\\windows\\temp\\",
      "\\users\\public\\",
      "\\programdata\\",
      "\\temp\\"
    ],
    "default_excluded_scan_ports": [
      80,
      443
    ],
    "default_internal_dns_suffixes": [
      ".local",
      ".lan",
      ".corp",
      ".internal"
    ]
  }
}