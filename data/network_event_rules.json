    "web_attack_patterns": [
      "../",
      "..%2f",
      "%2e%2e",
      "union select",
      "select%20",
      "' or 1=1",
      "\" or \"1\"=\"1",
      "information_schema",
      "<script",
      "%3cscript",
      "javascript:",
      "onerror=",
      "onload=",
      "/etc/passwd",
      "boot.ini",
      ".env",
      "wp-config.php",
      "cmd=",
      "exec="
